  const ul=$('list');ul.textContent='';
  S.photos.forEach((p,i)=>{
    const li=h('li','item');li.dataset.i=i;
    const img=h('img');img.src=p.src;img.alt='Foto '+(i+1);
    const inp=h('input');inp.type='text';inp.placeholder='Legenda da foto '+(i+1);inp.value=p.cap;inp.maxLength=70;inp.dataset.i=i;
    const ctl=h('div','ctl');
    [['up','↑','Subir'],['down','↓','Descer'],['del','✕','Remover']].forEach(([a,t,l])=>{
      const b=h('button',null,t);b.dataset.a=a;b.setAttribute('aria-label',l);b.type='button';ctl.append(b)});
    li.append(img,inp,ctl);ul.append(li)});
  const n=S.photos.length;
  $('dl').disabled=$('prev').disabled=!n;
  $('hint').textContent=n?n+(n===1?' foto adicionada.':' fotos adicionadas.'):'Adicione pelo menos uma foto.';
}
$('list').addEventListener('input',e=>{if(e.target.dataset.i!=null)S.photos[+e.target.dataset.i].cap=e.target.value});
$('list').addEventListener('click',e=>{
  const b=e.target.closest('button');if(!b)return;
  const i=+b.closest('li').dataset.i,a=b.dataset.a,P=S.photos;
  if(a==='del')P.splice(i,1);
  if(a==='up'&&i>0)[P[i-1],P[i]]=[P[i],P[i-1]];
  if(a==='down'&&i<P.length-1)[P[i+1],P[i]]=[P[i],P[i+1]];
  renderList()});

function makeHTML(){
  const d=$('date').value,t=$('time').value||'00:00';
  const D={title:$('title').value.trim()||'Nosso álbum',to:$('to').value.trim(),
    start:d?d+'T'+t:'',sky:d?d+'T'+($('time').value||'20:00'):'',place:{name:'Catanduva, SP',lat:-21.1378,lon:-48.9728,tz:-3},letter:$('letter').value.trim(),seal:$('seal').value.trim(),msg:$('msg').value.trim(),sign:$('sign').value.trim(),photos:S.photos,audio:S.audio};
  const j=JSON.stringify(D).replace(/</g,'\\u003c');
  const body=$('vt').innerHTML.replace('/*DATA*/null',()=>j);
  return '<!DOCTYPE html><html lang="pt-BR"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover"><link href="https://fonts.googleapis.com/css2?family=Young+Serif&family=Caveat:wght@500;700&family=Figtree:wght@400;600&display=swap" rel="stylesheet"><title>'+esc(D.title)+'</title></head><body>'+body+'</body></html>';
}

$('prev').onclick=()=>{$('pvf').srcdoc=makeHTML();$('pv').hidden=false};
$('pvb').onclick=()=>{$('pv').hidden=true;$('pvf').srcdoc=''};

$('dl').onclick=async()=>{
  const slug=($('title').value||'album').normalize('NFD').replace(/[\u0300-\u036f]/g,'').replace(/[^a-zA-Z0-9]+/g,'-').replace(/^-|-$/g,'').toLowerCase()||'album';
  const name=slug+'.html',blob=new Blob([makeHTML()],{type:'text/html'});
  try{
    if(dl){await dl.save({filename:name,data:blob});$('hint').textContent='Álbum salvo. Agora é só enviar o arquivo '+name+'.'}
    else{const a=h('a');a.href=URL.createObjectURL(blob);a.download=name;document.body.append(a);a.click();a.remove();
      $('hint').textContent='Se o download não começou, abra esta página no navegador do celular ou computador.'}
  }catch(e){
    if(e&&e.code==='declined')return;
    $('hint').textContent='Não foi possível salvar aqui. Abra esta página pelo claude.ai e tente de novo.'}
};
</script>
</body>
