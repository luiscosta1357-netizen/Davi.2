<script>
(function(){
var D=/*DATA*/null;
document.title=D.title||'Nosso álbum';
function $(i){return document.getElementById(i)}
function h(t,c,x){var e=document.createElement(t);if(c)e.className=c;if(x!=null)e.textContent=x;return e}
var book=$('book'),aud=$('aud'),builders=[],leaves=[],cur=0,units=[],since=null,st=null,started=false;
var L=[['ano','anos'],['mês','meses'],['dia','dias'],['hora','horas'],['minuto','minutos'],['segundo','segundos']];

if(D.start){var m=/(\d+)-(\d+)-(\d+)T(\d+):(\d+)/.exec(D.start);if(m)st=new Date(+m[1],+m[2]-1,+m[3],+m[4],+m[5])}

builders.push(function(){
  var p=h('div','pg cover');
  p.append(h('h2',null,D.title||'Nosso álbum'));
  if(D.to)p.append(h('p',null,'para '+D.to));
  if(st)p.append(h('p',null,st.toLocaleDateString('pt-BR',{day:'numeric',month:'long',year:'numeric'})));
  p.append(h('small',null,'Toque para abrir'));
  return p});

if(st)builders.push(function(){
  var p=h('div','pg count');
  for(var i=0;i<6;i++){var s=h('span','hp','♥');s.style.left=(8+i*16)+'%';s.style.animationDelay=(i*1.1)+'s';p.append(s)}
  p.append(h('h3',null,'Estamos juntos há'));
  var g=h('div','units');
  L.forEach(function(){var u=h('div','u'),b=h('b','0'),s=h('span','');u.append(b,s);g.append(u);units.push([b,s])});
  since=h('p','since');
  p.append(g,since);tick();return p});

D.photos.forEach(function(ph,i){builders.push(function(){
  var p=h('div','pg'),f=h('figure','polaroid');
  f.style.setProperty('--r',(i%2?2:-2)+'deg');
  var im=h('img');im.src=ph.src;im.alt=ph.cap||('Foto '+(i+1));
  f.append(im,h('div','cap',ph.cap||''));
  p.append(f,h('span','num',(i+1)+' / '+D.photos.length));return p})});

if(D.msg||D.sign)builders.push(function(){
  var p=h('div','pg end');
  p.append(h('h3',null,'Para você'));
